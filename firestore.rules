rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn() || true;
      allow write: if isSignedIn() || true;
    }

    // Learning Materials collection
    match /materials/{materialId} {
      allow read: if true;
      allow write: if isSignedIn() || true;
    }

    // Questions Bank collection
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isSignedIn() || true;
    }

    // Exam / Practice Results collection
    match /results/{resultId} {
      allow read: if true;
      allow write: if isSignedIn() || true;
    }

    // Connection health check
    match /test/{testId} {
      allow read: if true;
    }
  }
}
